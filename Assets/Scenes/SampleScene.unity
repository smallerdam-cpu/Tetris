  creditsContent: "\r\nFIESTA DE BLOQUES\r\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\r\n\r\nDESARROLLO\r\n\u2022
    Desarrollador Principal: Roberto Smith Hernandez Ramirez\r\n\u2022 Programaci\xF3n:
    C# - Unity\r\n\r\nDISE\xD1O\r\n\u2022 Dise\xF1o de Interfaz: Roberto Smith Hernandez
    Ramirez\r\n\u2022 Dise\xF1o de Personajes: Roberto Smith Hernandez Ramirez\r\n\r\nARTE\r\n\u2022
    Sprites de Piezas: Roberto Smith Hernandez Ramirez\r\n\u2022 Personajes Espectadores:
    Roberto Smith Hernandez Ramirez\r\n\u2022 Temas Visuales: Roberto Smith Hernandez
    Ramirez\r\n\r\nM\xDASICA\r\n\u2022 Composici\xF3n M\xFAsica Men\xFA.\r\n\u2022
    Composici\xF3n M\xFAsica Gameplay.\r\n\u2022 Canciones Gameplay.\r\n\r\nSONIDO\r\n\u2022
    Efectos de Sonido: Roberto Smith Hernandez Ramirez\r\n\u2022 Dise\xF1o de Audio:
    Roberto Smith Hernandez Ramirez\r\n\r\nAGRADECIMIENTOS\r\nGracias a todos por
    jugar\r\n\r\n\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n\xA9
    2026 Robert Smith\n\xA9 2026 Infra-Red Company\r\n\xA9 2026 - Todos los derechos
    reservados\r\n"
